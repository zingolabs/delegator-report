{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off"
  },
  "ignorePatterns": [".output", ".nitro", ".wrangler", "node_modules", ".pnpm-store"]
}
